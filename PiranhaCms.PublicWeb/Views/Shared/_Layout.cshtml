@using Microsoft.ApplicationInsights.AspNetCore
@using Piranha.Models
@using PiranhaCMS.PublicWeb.Components
@using PiranhaCMS.PublicWeb.Models.ViewModels.Base
@model IPageViewModel<PiranhaCMS.ContentTypes.Pages.Base.IPage>

<!doctype html>
<html lang="@Model.GlobalSettings.LanguageCode" class="no-js">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    @if (Model.CurrentPage is IMeta meta)
    {
        <partial name="Partial/_Meta.cshtml" model="@meta" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/css/styles.bundle.css?v=1738507712" rel="stylesheet">
    <link rel="shortcut icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" href="~/assets/img/apple-touch-icon.png">
    <link rel="icon" href="~/assets/img/touch-icon.png">
    <title>@Model.GlobalSettings.PageTitle</title>
    
    <!-- Content Recommendations Scripts -->
    <script type="text/javascript">
        !function(d,s){var ip=d.createElement(s);ip.async=1,s=d.getElementsByTagName(s)[0],ip.src='//s.usea01.idio.episerver.net/ip.js',s.parentNode.insertBefore(ip,s)}(document,'script');
    </script>

    <!-- idio Analytics Tracking Code -->
    <script type="text/javascript">
        // Set client and delivery

        _iaq = [
            ['client', 'e3413e2d12ad4bef8d582f9f467d3cbd'],
            ['delivery', 1971],
            ['track', 'consume']
        ];

        // Include the Idio Analytics JavaScript
        !function(d,s){var ia=d.createElement(s);ia.async=1,s=d.getElementsByTagName(s)[0],ia.src='//s.usea01.idio.episerver.net/ia.js',s.parentNode.insertBefore(ia,s)}(document,'script');
    </script>
    <!-- / idio Analytics Tracking Code -->

    @if (!string.IsNullOrEmpty(javaScriptSnippet?.FullScript))
    {
        <!-- Application Insights Script -->
        @Html.Raw(javaScriptSnippet.FullScript)
    }

    @RenderSection("head", required: false)
</head>
<body>
    <partial name="Partial/_PageHeader.cshtml" model="@Model" />

    @RenderBody()

    @*@await Component.InvokeAsync(nameof(Test))*@
    <partial name="Partial/_PageFooter.cshtml" model="@Model" />

    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top"><i class="bi bi-arrow-up"></i></a>
    
    <script src="~/assets/js/scripts.bundle.js?v=1717340545"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    @* <script>
        $(".goalClick").click(function () {
            _iaq.push(['goal', 'Sign Up']);
            $(this).html('You are now signed up!');
            console.log('Tracking data pushed');
        });
    </script> *@

    @RenderSection("scripts", required: false)
</body>
</html>
