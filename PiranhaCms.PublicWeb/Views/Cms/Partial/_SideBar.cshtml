@using PiranhaCMS.ContentTypes.Helpers;
@{
    var searchPage = PageHelpers.GetSiteSettings().SearchPageReference?.Page?.Permalink;
    var searchQuery = PiranhaCMS.Common.Helpers.PageHelpers.GetSearchQuery();
}

@if (searchPage != null)
{
<div class="mb-5">
    @using (Html.BeginForm(FormMethod.Get, new { action = searchPage }))
    {
        <div class="mb-5 input-group">
            @Html.TextBox("q", searchQuery, new { @class = "form-control p-3", placeholder = "Search keywords"})
            <button class="btn btn-primary px-4" title="Search"><i class="bi bi-search"></i></button>
        </div>
    }
</div>
}

<div class="mb-5">
    <h2 class="mb-4">Want To Know More?</h2>
    <div class="bg-secondary text-center" style="padding: 30px;">
        <p>If you are still thinking on having a great web site but not sure how to make it or if you need more information on CMS and related technologies, please contact us.</p>
        <a href="/contact" class="btn btn-primary rounded-pill py-2 px-4">Contact Us</a>
        <br /> or <br />
        <!-- Google Calendar Appointment Scheduling begin -->
        <link href="https://calendar.google.com/calendar/scheduling-button-script.css" rel="stylesheet">
        <script src="https://calendar.google.com/calendar/scheduling-button-script.js" async></script>
        <script>
            (function() {
              var target = document.currentScript;
              window.addEventListener('load', function() {
                calendar.schedulingButton.load({
                  url: 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ1azPtiUjr7O0Trn9TsPqH1OjhHgUoJKH-J94G2ku0E9_5a-GnF8zNBr_oOt0C2AHwM5JeGAZl-?gv=true',
                  color: '#F3525A',
                  label: 'Book an appointment',
                  target,
                });
              });
            })();
        </script>
        <!-- end Google Calendar Appointment Scheduling -->
    </div>
</div>

<div class="mb-5">
    <div class="btn btn-primary goalClick">Sign Up</div>
    <h2 class="mb-4">Recommendations</h2>
    <script class="idio-recommendations" type="text/x-mustache" data-api-key="IEXKHQVQLW3Q7Y00LF6X">
        {{#content}}
        <div class="idio-recommendation">
            {{#main_image_url}}
                <a href="{{link_url}}"><img src="{{main_image_url}}?w=150&amp;h=150" class="image" /></a>
            {{/main_image_url}}

            <h3><a href="{{link_url}}">{{title}}</a></h3>
            <p>
                {{abstract}}
                <a href="{{link_url}}">Read more...</a>
            </p>

            <div class="meta">
                <ul class="topics">
                    {{#topics}}
                    <li>{{title}}</li>
                    {{/topics}}
                </ul>

                {{#source}}
                    <span class="source">{{title}}</span>
                {{/source}}

               {{#author}}
                   <span class="author">{{title}}</span>
               {{/author}}
           </div>
        </div>
        {{/content}}
    </script>
</div>
