@model PiranhaCMS.Search.Models.Dto.SearchResultDto<MusicLibraryDocument>
@using PiranhaCMS.ContentTypes.Helpers;
@using PiranhaCMS.Search.Models
@using PiranhaCMS.Search.Models.Facets

@if (Model.Facets != null && Model.Facets.Any())
{
    foreach (var item in Model.Facets.Where(x => x.Name.Equals("art")))
    {
        <div class="row py-1">
            <div class="col">
                <b>Artist</b>
            </div>
        </div>
        <div class="row">
            <div class="col">
                @if (item.Values != null && item.Values.Any())
                {
                    foreach (var subitem in item.Values.OrderBy(x => x.Value))
                    {
                        <div>
                            <a href="@subitem.QueryString">@subitem.Value</a>
                            <span class="badge bg-primary rounded-pill">@subitem.Count</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
    
    if (Model.SearchRequest.SearchFields.Any(x => x.Name == "art"))
    {
        foreach (var item in Model.Facets.Where(x => x.Name.Equals("rel")))
        {
            <div class="row py-1">
                <div class="col">
                    <b>Release</b>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    @if (item.Values != null && item.Values.Any())
                    {
                        foreach (var subitem in item.Values.OrderBy(x => x.Value))
                        {
                            <div>
                                <a href="@subitem.QueryString">@subitem.Value</a>
                                <span class="badge bg-primary rounded-pill">@subitem.Count</span>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
}
