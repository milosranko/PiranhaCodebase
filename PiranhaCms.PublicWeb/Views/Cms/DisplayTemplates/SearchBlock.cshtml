@using PiranhaCMS.ContentTypes.Helpers
@model PiranhaCMS.ContentTypes.Blocks.SearchBlock
@{
    var searchPage = PageHelpers.GetSiteSettings().SearchPageReference?.Page?.Permalink;
}

<section class="search-section reveal">
    <div class="row">
        <h2 class="search-heading">@Model.Heading.Value</h2>
        <p>@Model.LeadText.Value</p>

        @using (Html.BeginForm(FormMethod.Get, new { action = searchPage }))
        {
            <fieldset>
                <label for="q" class="visually-hidden">@Model.Heading.Value</label>
                <input type="search" id="q" name="q" placeholder="Search..." aria-label="@Model.Heading.Value" />
                <button type="submit">Search</button>
            </fieldset>
        }
    </div>
</section>
