@model PiranhaCMS.ContentTypes.Blocks.ServicesBlockGroup

<section class="services-section reveal">
    <div class="row">
        @if (!string.IsNullOrEmpty(Model.Title?.Value))
        {
            <p class="section-eyebrow text-uppercase text-primary text-center mb-1">@Model.Title.Value</p>
        }
        @if (!string.IsNullOrEmpty(Model.Heading?.Value))
        {
            <h2 class="section-title text-center mb-0">@Model.Heading.Value</h2>
        }

        @if (Model.Items != null && Model.Items.Count > 0)
        {
            foreach (var item in Model.Items)
            {
                <partial name="TeaserBlock.cshtml" model="@item" />
            }
        }
    </div>
</section>